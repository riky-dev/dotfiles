[aztaskbar]
desaturation-factor=0.0
favorites=false
icon-size=20
icon-style='REGULAR'
main-panel-height=(false, 30)
multi-window-indicator-style='MULTI_DASH'
notification-badges=true
position-in-panel='RIGHT'
position-offset=9
show-apps-button=(false, 0)
show-panel-activities-button=false
show-panel-appmenu-button=false
tool-tips=false

[caffeine]
countdown-timer=0
enable-fullscreen=false
indicator-position-max=2
restore-state=true
show-indicator='always'

[clipboard-indicator]
cache-size=1025
disable-down-arrow=true
display-mode=0
history-size=75
move-item-first=true
refresh-interval=1000
strip-text=true
toggle-menu=['<Super>v']
topbar-preview-size=10

[just-perfection]
accessibility-menu=true
activities-button=false
app-menu=false
app-menu-icon=true
app-menu-label=false
clock-menu=true
dash-app-running=true
events-button=false
keyboard-layout=false
panel=true
show-apps-button=false
startup-status=0
switcher-popup-delay=true
window-demands-attention-focus=true
workspace-switcher-should-show=false
world-clock=false

[vitals]
alphabetize=true
fixed-widths=false
hide-icons=true
hot-sensors=['_processor_usage_', '_memory_usage_', '_processor_frequency_', '_battery_time_left_']
position-in-panel=0
show-battery=true
show-storage=false
update-time=2
